{
	frankenphp
	order php_server before file_server
}

:{$PORT:8080} {
	root * /app/public
	encode zstd br gzip

	# Vite assets have content hashes in their names, so browsers can keep them forever.
	@hashed path /build/assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@icons path /favicon.svg /favicon.ico /apple-touch-icon.png
	header @icons Cache-Control "public, max-age=86400"

	php_server
}
