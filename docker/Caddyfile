{
	# A fixed thread count: each PHP thread can hold one persistent database connection,
	# and the default (2 per CPU) can exceed what the database allows on a large host.
	frankenphp {
		num_threads {$FRANKENPHP_THREADS:16}
	}
	order php_server before file_server
}

:{$PORT:8080} {
	root * /app/public
	encode zstd br gzip

	# Vite assets have content hashes in their names, so browsers can keep them forever.
	@hashed path /build/assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@icons path /favicon.svg /favicon.ico /apple-touch-icon.png
	header @icons Cache-Control "public, max-age=86400"

	php_server
}
